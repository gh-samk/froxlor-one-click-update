{# One-Click Update: version status, the update button, progress and the last run.

   Rendered by Froxlor\Ext\OneClickUpdate\Page. Extends Froxlor's base layout:
   the Twig loader is rooted in templates/, so "Froxlor/..." resolves from
   this directory as well.

   Every block is wrapped in v-pre: Froxlor mounts Vue on <body id="app"> and
   thereby evaluates the whole page as a template. Without v-pre, text like
   {{ ... }} in a log line would run as code in the admin's browser.

   Only Bootstrap classes, no stylesheet of its own: the page follows the
   light/dark variant of every theme by itself. #}
{% extends "Froxlor/userarea.html.twig" %}

{% macro step_icon(state) %}
	{%- if state == 'done' -%}
		<i class="fa-solid fa-circle-check text-success" aria-hidden="true"></i>
	{%- elseif state == 'active' -%}
		<span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
	{%- elseif state == 'failed' -%}
		<i class="fa-solid fa-circle-xmark text-danger" aria-hidden="true"></i>
	{%- else -%}
		<i class="fa-regular fa-circle text-body-tertiary" aria-hidden="true"></i>
	{%- endif -%}
{% endmacro %}

{% block heading %}
<div v-pre>
	<h5 class="mb-1">
		<i class="fa-solid fa-cloud-arrow-down me-1" aria-hidden="true"></i>
		{{ ocu_t('Froxlor update') }}
	</h5>
	<span class="text-body-secondary mt-2">{{ ocu_t('Bring Froxlor up to date with one click — with a snapshot taken first.') }}</span>
</div>
{% endblock %}

{% block actions %}
<div v-pre>
	{% if not running %}
		<a class="btn btn-outline-secondary text-nowrap" href="{{ linker({'section': 'one_click_update'}) }}?check=1">
			<i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
			<span class="d-none d-lg-inline ms-lg-1">{{ ocu_t('Check again') }}</span>
		</a>
	{% endif %}
</div>
{% endblock %}

{% block content %}
{% import _self as m %}
<div v-pre>
	{% if flash %}
		<div class="alert alert-{{ flash.type }} alert-dismissible fade show" role="{{ flash.type == 'danger' ? 'alert' : 'status' }}">
			{{ flash.text }}
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ ocu_t('Close') }}"></button>
		</div>
	{% endif %}

	{% if not installed %}
		<div class="alert alert-warning" role="status">
			<p class="fw-semibold mb-1">{{ ocu_t('The update service is not installed on this server.') }}</p>
			<p class="mb-0">{{ ocu_t('The panel cannot update Froxlor by itself — that needs root. Run install.sh of One-Click Update as root once; it sets up a small service that does the update when you click the button.') }}</p>
		</div>
	{% endif %}

	{% if stuck %}
		<div class="alert alert-warning" role="status">
			<p class="fw-semibold mb-1">{{ ocu_t('The update request was not picked up.') }}</p>
			<p class="mb-0">{{ ocu_t('The service on the server did not start. As root, check it with: systemctl status froxlor-one-click-update.path froxlor-one-click-update.service — then request the update again.') }}</p>
		</div>
	{% endif %}

	{% if stale %}
		<div class="alert alert-warning" role="status">
			{{ ocu_t('The last run started at %s and never reported back. It was probably interrupted; the log below shows how far it got.', run.started) }}
		</div>
	{% endif %}

	<div class="row g-3">
		<div class="col-12 col-xl-8">

			{% if running %}
				{# Live view. The script at the end refreshes the steps and the log. #}
				<section class="card" aria-labelledby="ocu-progress-title">
					<div class="card-body">
						<div class="d-flex align-items-center gap-3 mb-3">
							<span class="spinner-border text-primary flex-shrink-0" aria-hidden="true"></span>
							<div>
								<h2 class="h5 mb-0" id="ocu-progress-title">
									{% if pending %}
										{{ ocu_t('Update requested — starting …') }}
									{% else %}
										{{ ocu_t('Froxlor is being updated') }}
									{% endif %}
								</h2>
								{% if run and run.from and run.target and not pending %}
									<span class="text-body-secondary">{{ ocu_t('From %s to %s', run.from, run.target) }}</span>
								{% endif %}
							</div>
						</div>

						<ol class="list-unstyled mb-3" id="ocu-steps" aria-live="polite">
							{% for step in steps %}
								<li class="d-flex align-items-center gap-2 py-1" data-step="{{ step.key }}" data-state="{{ step.state }}">
									<span class="ocu-icon d-inline-flex justify-content-center" style="width: 1.25rem">{{ m.step_icon(step.state) }}</span>
									<span class="{{ step.state == 'todo' ? 'text-body-secondary' }}{{ step.state == 'active' ? 'fw-semibold' }}">{{ step.label }}</span>
								</li>
							{% endfor %}
						</ol>

						<p class="small text-body-secondary mb-2">
							{{ ocu_t('This page refreshes itself. You can also close it: the update keeps running on the server.') }}
							<a href="{{ linker({'section': 'one_click_update'}) }}">{{ ocu_t('Refresh now') }}</a>
						</p>
						<pre class="bg-body-tertiary border rounded p-2 small mb-0 overflow-auto" style="max-height: 22rem; white-space: pre-wrap; overflow-wrap: anywhere" id="ocu-log" tabindex="0" aria-label="{{ ocu_t('Log') }}">{{ pending ? '' : log }}</pre>
					</div>
				</section>

			{% elseif check and check.newer %}
				<section class="card border-start border-4 border-warning" aria-labelledby="ocu-available-title">
					<div class="card-body">
						<h2 class="h4 mb-1" id="ocu-available-title">{{ ocu_t('Froxlor %s is available.', check.version) }}</h2>
						<p class="text-body-secondary mb-3">
							{{ ocu_t('Installed: %s', current) }} · {{ ocu_t('Channel: %s', channel) }}
							{% if check.link %}
								· <a href="{{ check.link }}" target="_blank" rel="noopener noreferrer">{{ ocu_t('Release notes') }} <i class="fa-solid fa-arrow-up-right-from-square small" aria-hidden="true"></i></a>
							{% endif %}
						</p>
						{% if check.info %}
							<p class="mb-3">{{ check.info }}</p>
						{% endif %}

						<form method="post" action="{{ linker({'section': 'one_click_update'}) }}" class="mb-3">
							<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
							<input type="hidden" name="send" value="send">
							<input type="hidden" name="action" value="start">
							<button type="submit" class="btn btn-primary btn-lg" {{ not installed ? 'disabled' }}>
								<i class="fa-solid fa-download me-1" aria-hidden="true"></i>
								{{ ocu_t('Update now') }}
							</button>
						</form>

						<ul class="small text-body-secondary mb-0 ps-3">
							{% if runner and runner.snapshots > 0 %}
								<li>{{ ocu_t('First the server takes a snapshot of Froxlor\'s files and its database; the last %d are kept.', runner.snapshots) }}</li>
							{% elseif runner %}
								<li>{{ ocu_t('Snapshots are switched off on this server (SNAPSHOTS=0).') }}</li>
							{% endif %}
							<li>{{ ocu_t('Websites, email and customer databases keep running. The update usually takes one to two minutes.') }}</li>
							{% if runner and runner.reinstall is not empty %}
								<li>{{ ocu_t('Afterwards the installed extensions are set up again (%d).', runner.reinstall|length) }}</li>
							{% endif %}
							<li>{{ ocu_t('Finally the extensions are checked against the new version: menu, settings, classes and templates must still load. Problems are reported here.') }}</li>
						</ul>
					</div>
				</section>

			{% elseif check and check.ok %}
				<section class="card border-start border-4 border-success" aria-labelledby="ocu-current-title">
					<div class="card-body d-flex align-items-center gap-3">
						<i class="fa-solid fa-circle-check fa-2x text-success flex-shrink-0" aria-hidden="true"></i>
						<div>
							<h2 class="h5 mb-1" id="ocu-current-title">{{ ocu_t('Froxlor is up to date.') }}</h2>
							<span class="text-body-secondary">{{ ocu_t('Installed: %s', current) }} · {{ ocu_t('Channel: %s', channel) }}</span>
						</div>
					</div>
				</section>

			{% elseif check %}
				<section class="card border-start border-4 border-danger" aria-labelledby="ocu-error-title">
					<div class="card-body">
						<h2 class="h5 mb-1" id="ocu-error-title">{{ ocu_t('The version check failed.') }}</h2>
						<p class="mb-1">{{ check.error }}</p>
						<span class="text-body-secondary">{{ ocu_t('Installed: %s', current) }} · {{ ocu_t('Channel: %s', channel) }}</span>
					</div>
				</section>
			{% endif %}

			{% if run and not running %}
				<section class="card mt-3" aria-labelledby="ocu-last-title">
					<div class="card-header bg-body-tertiary">
						<h2 class="h6 mb-0 fw-semibold" id="ocu-last-title">{{ ocu_t('Last run') }}</h2>
					</div>
					<div class="card-body">
						<p class="d-flex gap-2 mb-3">
							{% if run.warning %}
								<i class="fa-solid fa-triangle-exclamation text-warning mt-1" aria-hidden="true"></i>
							{% elseif run.success %}
								<i class="fa-solid fa-circle-check text-success mt-1" aria-hidden="true"></i>
							{% else %}
								<i class="fa-solid fa-circle-xmark text-danger mt-1" aria-hidden="true"></i>
							{% endif %}
							<span>{{ run.message }}</span>
						</p>
						{% if run.problems is not empty %}
							<ul class="small mb-3" id="ocu-problems">
								{% for problem in run.problems %}<li><code class="text-break">{{ problem }}</code></li>{% endfor %}
							</ul>
							{% if run.install_failed is not empty %}
								<p class="small mb-2">{{ ocu_t('In addition, the installer of these extensions failed: %s', run.install_failed|join(', ')) }}</p>
							{% endif %}
							<p class="small mb-3">{{ run.snapshot ? ocu_t('Update the extension or tell its author. If the panel shows errors in the meantime, put the snapshot back with the command below.') : ocu_t('Update the extension or tell its author.') }}</p>
						{% elseif run.compat == 'ok' %}
							<p class="small text-body-secondary mb-3">{{ ocu_t('The extensions were checked with the new version: no new problems.') }}</p>
						{% elseif run.compat == 'unavailable' %}
							<p class="small text-body-secondary mb-3">{{ ocu_t('The extensions could not be checked with the new version. Details are in the log.') }}</p>
						{% endif %}
						<dl class="row small mb-0">
							{% if run.started %}
								<dt class="col-sm-4 col-lg-3 fw-normal text-body-secondary">{{ ocu_t('Started') }}</dt>
								<dd class="col-sm-8 col-lg-9">{{ run.started }}{% if run.duration %} · {{ ocu_t('took %s', run.duration) }}{% endif %}</dd>
							{% endif %}
							{% if requested_by %}
								<dt class="col-sm-4 col-lg-3 fw-normal text-body-secondary">{{ ocu_t('Requested by') }}</dt>
								<dd class="col-sm-8 col-lg-9">{{ requested_by.admin }} ({{ requested_by.when }})</dd>
							{% endif %}
							{% if run.method %}
								<dt class="col-sm-4 col-lg-3 fw-normal text-body-secondary">{{ ocu_t('Method') }}</dt>
								<dd class="col-sm-8 col-lg-9">{{ run.method }}</dd>
							{% endif %}
							{% if run.snapshot %}
								<dt class="col-sm-4 col-lg-3 fw-normal text-body-secondary">{{ ocu_t('Snapshot') }}</dt>
								<dd class="col-sm-8 col-lg-9">
									<code>{{ run.snapshot }}</code>
									<div class="text-body-secondary mt-1">{{ ocu_t('To go back, run as root on the server:') }}</div>
									<code class="user-select-all">froxlor-one-click-update restore {{ run.snapshot }}</code>
								</dd>
							{% endif %}
						</dl>
						{% if log %}
							<details class="mt-3">
								<summary class="small">{{ ocu_t('Show log') }}</summary>
								<pre class="bg-body-tertiary border rounded p-2 small mt-2 mb-0 overflow-auto" style="max-height: 22rem; white-space: pre-wrap; overflow-wrap: anywhere" tabindex="0">{{ log }}</pre>
							</details>
						{% endif %}
					</div>
				</section>
			{% endif %}
		</div>

		<div class="col-12 col-xl-4">
			<section class="card" aria-labelledby="ocu-how-title">
				<div class="card-header bg-body-tertiary">
					<h2 class="h6 mb-0 fw-semibold" id="ocu-how-title">{{ ocu_t('How it works') }}</h2>
				</div>
				<div class="card-body small">
					<p>{{ ocu_t('The button only leaves a request. A service on the server picks it up within seconds and runs the update as root — the same steps an administrator would type in the shell.') }}</p>
					{% if runner %}
						<dl class="mb-3">
							<dt class="fw-normal text-body-secondary">{{ ocu_t('Method') }}</dt>
							<dd>{{ runner.method }}</dd>
							<dt class="fw-normal text-body-secondary">{{ ocu_t('Snapshots kept') }}</dt>
							<dd>{{ runner.snapshots > 0 ? runner.snapshots : ocu_t('none') }}</dd>
							{% if runner.reinstall is not empty %}
								<dt class="fw-normal text-body-secondary">{{ ocu_t('Extensions set up again afterwards') }}</dt>
								<dd class="mb-0">
									<ul class="list-unstyled mb-0">
										{% for pkg in runner.reinstall %}<li><code>{{ pkg }}</code></li>{% endfor %}
									</ul>
								</dd>
							{% endif %}
						</dl>
					{% endif %}
					<p class="mb-1 text-body-secondary">{{ ocu_t('On the server (as root):') }}</p>
					<ul class="list-unstyled mb-0">
						<li><code>froxlor-one-click-update check</code></li>
						<li><code>froxlor-one-click-update status</code></li>
						<li><code>froxlor-one-click-update snapshots</code></li>
						<li><code>froxlor-one-click-update restore &lt;snapshot&gt;</code></li>
					</ul>
				</div>
			</section>
		</div>
	</div>

	{% if running %}
		{# Live refresh while a run is going on. The browser runs this while
		   parsing, before Froxlor's Vue mounts and discards script tags; the
		   timer stays and looks the elements up again on every tick, because
		   Vue replaces them. Without JavaScript the "Refresh now" link does
		   the same. #}
		<script>
			(function () {
				var url = {{ (linker({'section': 'one_click_update'}) ~ '?page=progress')|json_encode|raw }};
				var icons = {
					done: '<i class="fa-solid fa-circle-check text-success" aria-hidden="true"></i>',
					active: '<span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>',
					failed: '<i class="fa-solid fa-circle-xmark text-danger" aria-hidden="true"></i>',
					todo: '<i class="fa-regular fa-circle text-body-tertiary" aria-hidden="true"></i>'
				};
				// Rendered while the request still waited: once the service has
				// taken it, reload once for the heading with versions.
				var wasPending = {{ pending ? 'true' : 'false' }};
				var busy = false;
				function tick() {
					if (busy) { return; }
					busy = true;
					fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
						.then(function (r) { return r.ok ? r.json() : null; })
						.then(function (data) {
							busy = false;
							if (!data) { return; }
							if (!data.running || (wasPending && !data.pending)) { window.location.reload(); return; }
							var log = document.getElementById('ocu-log');
							if (log && typeof data.log === 'string' && log.textContent !== data.log) {
								var atEnd = log.scrollTop + log.clientHeight >= log.scrollHeight - 8;
								log.textContent = data.log;
								if (atEnd) { log.scrollTop = log.scrollHeight; }
							}
							(data.steps || []).forEach(function (s) {
								var li = document.querySelector('#ocu-steps [data-step="' + s.key + '"]');
								if (!li || li.getAttribute('data-state') === s.state || !icons[s.state]) { return; }
								li.setAttribute('data-state', s.state);
								li.querySelector('.ocu-icon').innerHTML = icons[s.state];
								var label = li.lastElementChild;
								label.className = s.state === 'todo' ? 'text-body-secondary' : (s.state === 'active' ? 'fw-semibold' : '');
							});
						})
						.catch(function () { busy = false; });
				}
				setInterval(tick, 3000);
				document.addEventListener('DOMContentLoaded', function () {
					var log = document.getElementById('ocu-log');
					if (log) { log.scrollTop = log.scrollHeight; }
				});
			})();
		</script>
	{% endif %}
</div>
{% endblock %}
